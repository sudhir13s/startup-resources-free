# ResourceOS — env vars
# v0.1 needs only BACKEND_URL + CORS_ORIGINS for cross-service wiring.
# v0.2+ uses the LLM provider keys (commented). Sign up only what you need;
# missing keys are silently dropped from the freellm/ chain at startup.

# === v0.1 service wiring ===
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# === v0.2 free LLM providers (text + multimodal) ===
# GROQ_API_KEY=                    # console.groq.com
# GEMINI_API_KEY=                  # aistudio.google.com
# OPENROUTER_API_KEY=              # openrouter.ai
# CEREBRAS_API_KEY=                # cloud.cerebras.ai
# TOGETHER_API_KEY=                # api.together.ai
# MISTRAL_API_KEY=                 # console.mistral.ai
# HF_TOKEN=                        # huggingface.co/settings/tokens
# NVIDIA_API_KEY=                  # build.nvidia.com
# SAMBANOVA_API_KEY=               # cloud.sambanova.ai
# AI21_API_KEY=                    # studio.ai21.com

# === v0.3+ multimodal (image / video / audio) ===
# REPLICATE_API_TOKEN=             # replicate.com
# FAL_API_KEY=                     # fal.ai
# VOYAGE_API_KEY=                  # voyageai.com
# COHERE_API_KEY=                  # dashboard.cohere.com
# DEEPGRAM_API_KEY=                # console.deepgram.com
# ASSEMBLYAI_API_KEY=              # assemblyai.com
# ELEVENLABS_API_KEY=              # elevenlabs.io

# === v0.3+ signup credits (claim them) ===
# DEEPINFRA_API_KEY=               # deepinfra.com
# FIREWORKS_API_KEY=               # fireworks.ai
# LEPTON_API_KEY=                  # lepton.ai
# FEATHERLESS_API_KEY=             # featherless.ai
# PERPLEXITY_API_KEY=              # perplexity.ai
# XAI_API_KEY=                     # console.x.ai
# ANTHROPIC_API_KEY=               # console.anthropic.com  (only if LLM_ALLOW_PAID=1)

# Opt-in flag for paid LLM calls. Default OFF (free-only).
# LLM_ALLOW_PAID=0
