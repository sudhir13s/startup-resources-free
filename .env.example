# ResourceOS — env vars
# v0.1 needs only BACKEND_URL + CORS_ORIGINS for cross-service wiring.
# v0.2+ uses the LLM provider keys (commented). Sign up only what you need;
# missing keys are silently dropped from the freellm/ chain at startup.

# === v0.1 service wiring ===
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# === Admin session (refresh button, candidate approve/reject) ===
# Shared passphrase between the Next.js server and the FastAPI backend.
# The Next.js server holds this value and forwards it as the
# `X-Admin-Token` header after the browser authenticates with an
# httpOnly session cookie — it never reaches client-side JS. Set the
# SAME value on the backend service. Leave unset to disable refresh
# (the TopBar falls back to a read-only freshness pill). Never prefix
# with NEXT_PUBLIC_ — that would ship it to the browser bundle.
ADMIN_TOKEN=

# === v0.2 free LLM providers (text + multimodal) ===
# GROQ_API_KEY=                    # console.groq.com
# GEMINI_API_KEY=                  # aistudio.google.com
# OPENROUTER_API_KEY=              # openrouter.ai
# CEREBRAS_API_KEY=                # cloud.cerebras.ai
