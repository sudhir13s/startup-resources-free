# Opt-in flag for paid LLM calls. Default OFF (free-only).
# LLM_ALLOW_PAID=0

# === Sprint #6 — search-API chain (weekly-discovery cron) ===
# Free-first quota-aware fallback. Sign up only what you need; missing
# keys are silently dropped from the chain. None of these require a
# credit card on the free tier.
# TAVILY_API_KEY=                  # app.tavily.com (1,000 / mo, primary)
# EXA_API_KEY=                     # dashboard.exa.ai (1,000 / mo)
# JINA_API_KEY=                    # jina.ai/api-dashboard (~10M tokens / mo)
# LINKUP_API_KEY=                  # app.linkup.so (1,000 / mo)
# SERPAPI_API_KEY=                 # serpapi.com (100 / mo, last resort)

# === Storage paths ===
# RESOURCEOS_DB_PATH=./data/resourceos.db
# SEARCH_QUOTA_DIR=./data/search
# FREELLM_QUOTA_DIR=./data/freellm
# VERIFY_QUEUE_DIR=./data/verify-queue
