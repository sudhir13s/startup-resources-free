# ResourceOS — env vars
# Full descriptions + a where/required/purpose table: see README.md "Deploy on Render".
# Missing LLM/search keys are silently dropped from their respective rotation at startup;
# the catalog is browsable with none of them set.

# === API service wiring ===
RESOURCEOS_DB_PATH=./data/resourceos.db       # SQLite file path (Render overrides to /tmp/resourceos.db — ephemeral disk)
SEED_PATH=./data/providers_seed.json          # applied on every boot; corrects existing records too (storage/seed_import.py)
# CORS_ORIGINS=                               # comma-separated full origins; opt-in only — the browser never calls
#                                              # the API directly, so this defaults to an empty (deny-all) allow-list.
# CORS_ORIGIN_HOST=                           # same idea via Render's fromService; API prepends https://

# === API access (every route but GET /api/health requires this) ===
# The API and the frontend's server routes derive the SAME key from this password
# (hex HMAC-SHA256, see api/auth.py + frontend/lib/admin.ts) and the frontend sends it as
# the X-ResourceOS-Key header on every request — the raw password itself is never sent over
# the wire or logged. Set the SAME value on both services (this is also RESOURCEOS_PASSWORD
# under "Frontend" below). Leave unset and the API returns 503 on every route except the
# health check. Never prefix with NEXT_PUBLIC_.
RESOURCEOS_PASSWORD=

# === R2 bucket sync (persists resourceos.db across Render's ephemeral disk) ===
# RESOURCEOS_R2_ENDPOINT=                           # S3 endpoint from the R2 overview page: https://<account-id>.r2.cloudflarestorage.com
# RESOURCEOS_R2_BUCKET=resourceos-data              # bucket name, e.g. created via R2 > Create bucket
# CF_USER_ACCESS_KEY_ID_19S=                      # R2 API token: Object Read & Write, scoped to this bucket
# CF_USER_R2_SECRET_ACCESS_KEY_19S=                  # paired secret for the access key above
# RESOURCEOS_R2_OBJECT_KEY=resourceos.db            # object key the DB is pulled from / pushed to

# === freellm — free-LLM provider keys (text / vision / embed) ===
# Any subset works; each missing key just drops that provider from the rotation.
# GROQ_API_KEY=                    # console.groq.com
# GEMINI_API_KEY=                  # aistudio.google.com
# OPENROUTER_API_KEY_19S=              # openrouter.ai
# CEREBRAS_API_KEY_19S=                # cloud.cerebras.ai
# MISTRAL_API_KEY=                 # console.mistral.ai
# NVIDIA_API_KEY_19S=                  # build.nvidia.com (NIM)
# HF_TOKEN=                        # huggingface.co/settings/tokens

# Opt-in flag for paid LLM calls. Default OFF (free-only).
# LLM_ALLOW_PAID=0

# === refresh/search.py — discovery search-provider keys ===
# Free-first quota-aware fallback chain: Tavily → Exa → Jina → Linkup → SerpAPI. Sign up only
# what you need; missing keys are dropped from the chain. None require a credit card on the
# free tier. JINA_API_KEY also powers the Jina Reader fetch fallback in refresh/fetch.py.
# TAVILY_API_KEY=                  # app.tavily.com (1,000 / mo, primary)
# EXA_API_KEY=                     # dashboard.exa.ai (1,000 / mo)
# JINA_API_KEY=                    # jina.ai/api-dashboard (~10M tokens / mo)
# LINKUP_API_KEY=                  # app.linkup.so (1,000 / mo)
# SERPAPI_API_KEY=                 # serpapi.com (100 / mo, last resort)

# === Frontend (frontend/.env.local or the Render frontend service) ===
BACKEND_URL=http://localhost:8000             # local dev; Render sets BACKEND_HOST via fromService instead
# BACKEND_HOST=                                # Render-provided bare hostname; frontend prepends https://

# Site login (gates the whole dashboard — app/login/page.tsx, frontend/middleware.ts) AND the
# source of the X-ResourceOS-Key backend header + the session cookie value. Leave either
# unset to disable login (the login route then returns 503) — RESOURCEOS_PASSWORD must match
# the API's.
# RESOURCEOS_USERNAME=
RESOURCEOS_PASSWORD=

NEXT_PUBLIC_APP_ENV=development
